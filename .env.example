# Database
POSTGRES_DB=gymtracker
POSTGRES_USER=gymtracker
POSTGRES_PASSWORD=change-me

# Ports exposed on the host by compose.yaml
API_PORT=8081
WEBSITE_PORT=8080

# Enrollment key devices (phone, watch) must present once to receive their own
# long-lived credentials. Change this before exposing the server publicly.
ENROLLMENT_KEY=change-me

# HMAC secret used to sign and verify device access tokens. Must be a long,
# random value in any real deployment — the default in code is NOT secret.
TOKEN_SIGNING_KEY=change-me-32-bytes-minimum

# Optional
TZ=UTC
LOG_LEVEL=info
